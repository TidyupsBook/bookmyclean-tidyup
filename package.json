{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/verify-package-manager.mjs",
    "build": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "stripe": "^22.4.0",
    "stripe-replit-sync": "^1.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.5",
      "brace-expansion@1": "^1.1.12",
      "brace-expansion@2": "^2.0.2",
      "brace-expansion@3": "^3.0.1",
      "brace-expansion@4": "^4.0.1",
      "brace-expansion@5": ">=5.0.9",
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "esbuild": ">=0.28.1",
      "js-yaml@4": ">=4.3.1 <5",
      "nanoid@3": ">=3.3.18 <4",
      "image-size": "2.0.2"
    },
    "patchedDependencies": {
      "@clerk/expo": "patches/@clerk__expo.patch",
      "image-size@2.0.2": "patches/image-size@2.0.2.patch"
    }
  }
}
